<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Agentwachter</RootNamespace>
    <AssemblyName>AgentwachterTray</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Agentwachter</Product>
    <Description>Running Claude Code and Codex sessions at a glance, in the Windows system tray.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icons the watcher's page uses: claude.png, codex.png. -->
    <EmbeddedResource Include="..\watcher\icons\*.png" LogicalName="%(Filename).png" />
  </ItemGroup>

</Project>
